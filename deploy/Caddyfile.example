# Add this site block to the server's existing Caddyfile, then `systemctl reload caddy`
# (or `caddy reload --config /etc/caddy/Caddyfile`). Caddy fetches the TLS certificate itself once
# DNS for the name points at the server. See spec/deployment.md.

chummer.example.org {
	# The app has its own accounts in hosted mode (WP137), so Caddy asks for nothing. A server still
	# running the pre-hosted app (no ~/chummer5/chummer5.env) needs the old `basicauth { ... }` block
	# here instead; remove it once hosted mode runs (spec/deployment.md, "Switching to hosted mode").

	# Just above the app's own cap for one upload request (20 files of up to 10 MB each, WP140),
	# so an oversized upload is answered by the app with a readable message, not by Caddy with a
	# bare 413 that the page can't show.
	request_body {
		max_size 210MB
	}

	encode zstd gzip
	# Caddy sets X-Forwarded-For to the client's address (replacing whatever the client sent) and
	# X-Forwarded-Proto to https; the app uses the first for its login throttle (WP141).
	reverse_proxy 127.0.0.1:8005
}
